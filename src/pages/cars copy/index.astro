---
import cars from "../../assets/cars.json";
const years = [...new Set(cars.map((c) => c.year))].sort();
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <ul>
        {
            years.map((y) => (
                <li class="m-4">
                    <a href={`/cars/year/${y}`}>Année : {y}</a>
                </li>
            ))
        }
    </ul>
</Layout>
